#!/usr/bin/env bash
# shellcheck disable=SC2016  # FR : les ${X:-…} écrits dans config.bash sont voulus littéraux
# =============================================================================
#  CoolBash — configuration interactive (`coolbash setup`)
#  FR : des questions à choix, des valeurs par défaut (Entrée les garde), et à
#       la fin un fichier ~/.coolbash/config.bash sourcé avant les modules.
#       Seuls les choix qui s'écartent du défaut sont écrits, sous la forme
#       `export X="${X:-valeur}"` : une variable posée dans le ~/.bashrc avant
#       la ligne source garde la priorité.
#       Une configuration existante est reprise : seules les questions apparues
#       depuis sa version sont posées (table SINCE). `--defaults` (ou une entrée
#       qui n'est pas un terminal) accepte tout sans rien demander.
#       Mode du ~/.bashrc : « source » (une ligne) ou « compiled » (autonome :
#       `coolbash compile --write`, régénéré à chaque install/update).
# =============================================================================
set -u

COOLBASH_PREFIX="${COOLBASH_PREFIX:-${HOME}/.coolbash}"
CONFIG="${COOLBASH_PREFIX}/config.bash"
CLI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/coolbash"
VERSION="$(sed -n 's/^COOLBASH_VERSION="\(.*\)"/\1/p' "$CLI" 2>/dev/null)"
DEFAULTS=0
[[ "${1:-}" == --defaults ]] && DEFAULTS=1
REUSE=0

declare -A CHOSEN=()  # variable → valeur choisie (différente du défaut)
declare -A CURRENT=() # variable → valeur du config.bash existant
CONFIG_VERSION=""

# FR : version de CoolBash où chaque réglage est apparu — pour ne poser que les
#      questions nouvelles quand on reprend une configuration.
declare -A SINCE=(
  [COOLBASH_MODE]=0.1.0 [COOLBASH_PROMPT_EMOJI]=0.2.0 [COOLBASH_PROMPT_MIN_MS]=0.3.0
  [COOLBASH_MOTD]=0.4.0 [COOLBASH_PS0_STAMP]=0.5.0 [COOLBASH_PROMPT_ICONS]=0.6.0
  [COOLBASH_PROMPT_GIT]=0.7.0 [COOLBASH_PROMPT_TOOLS]=0.7.0 [COOLBASH_PROMPT_BELL_MS]=0.7.0
  [COOLBASH_FZF]=0.9.0 [COOLBASH_NVM_LAZY]=0.10.0 [COOLBASH_STARTUP_TIME]=0.11.0
  [COOLBASH_FORTUNE]=0.13.0 [COOLBASH_MOTD_HIDE]=0.15.0 [COOLBASH_SERVE_PORT]=0.17.0
  [COOLBASH_PROMPT_PATH_FISH]=0.18.0 [COOLBASH_PROMPT_TRANSIENT]=0.18.0
  [COOLBASH_PROMPT_THEME]=0.19.0 [COOLBASH_UPDATE_CHECK]=0.19.0
  [COOLBASH_J]=0.20.0 [COOLBASH_CNF]=0.20.0 [COOLBASH_GIT_GUARD]=0.21.0
  [COOLBASH_HOOKS]=0.22.0 [COOLBASH_PROMPT_CLOUD]=0.23.0 [COOLBASH_INSTALL_MODE]=0.26.0
  [COOLBASH_PROMPT_OSC133]=0.30.0 [COOLBASH_HIST_SECRETS]=0.30.0 [COOLBASH_TMUX_SSH]=0.32.0
)

# FR : relit le config.bash actuel : sa version et les valeurs déjà choisies.
if [[ -r "$CONFIG" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^#\ CoolBash\ ([0-9.]+) ]] && CONFIG_VERSION="${BASH_REMATCH[1]}"
    [[ "$line" =~ ^export\ (COOLBASH_[A-Z_]+)=\"\$\{[A-Z_]+:-(.*)\}\"$ ]] && CURRENT[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"
  done <"$CONFIG"
fi

_say() { printf '%b\n' "$*"; }
_title() { printf '\n\e[1;36m%s\e[0m\n' "$*"; }

# FR : _newer A B → vrai si la version A est strictement plus récente que B.
_newer() {
  local -a a b
  IFS=. read -ra a <<<"$1"
  IFS=. read -ra b <<<"$2"
  local i
  for i in 0 1 2; do
    ((${a[i]:-0} > ${b[i]:-0})) && return 0
    ((${a[i]:-0} < ${b[i]:-0})) && return 1
  done
  return 1
}

# FR : en mode reprise, une question dont le réglage existait déjà dans la
#      version de la configuration reprise n'est pas reposée : la valeur
#      courante (ou le défaut) est conservée.
_skip() { # $1 = variable
  ((REUSE)) || return 1
  [[ -n "$CONFIG_VERSION" ]] || return 1
  _newer "${SINCE[$1]:-0.0.0}" "$CONFIG_VERSION" && return 1
  if [[ -n "${CURRENT[$1]+x}" ]]; then CHOSEN[$1]="${CURRENT[$1]}"; fi
  return 0
}

# FR : aperçu d'une palette (une ligne ; « full » = le prompt complet), rendu par la CLI.
_theme_preview() { COOLBASH_PREFIX="$COOLBASH_PREFIX" bash "$CLI" theme --preview "$1" ${2:+--full} 2>/dev/null; }

# FR : _choice VAR "question" "défaut" "val1|libellé 1" "val2|libellé 2" …
#      Si PREVIEW nomme une fonction, chaque option est suivie de son aperçu,
#      et « v N » affiche l'aperçu complet de l'option N avant de répondre.
_choice() {
  local var="$1" q="$2" def="$3" i=0 n reply val cur="${CURRENT[$1]:-$3}" idx_cur=1
  _skip "$var" && return 0
  shift 3
  local -a vals=() labels=()
  for opt in "$@"; do
    vals+=("${opt%%|*}")
    labels+=("${opt#*|}")
  done
  for i in "${!vals[@]}"; do [[ "${vals[i]}" == "$cur" ]] && idx_cur=$((i + 1)); done
  printf '\n%s\n' "$q"
  for i in "${!vals[@]}"; do
    n=$((i + 1))
    if ((n == idx_cur)); then printf '  \e[1m%d) %s\e[0m  ← actuel\n' "$n" "${labels[i]}"; else printf '  %d) %s\n' "$n" "${labels[i]}"; fi
    if [[ -n "${PREVIEW:-}" ]]; then
      printf '       %s\n' "$("$PREVIEW" "${vals[i]}")"
    fi
  done
  while :; do
    if [[ -n "${PREVIEW:-}" ]]; then printf 'Choix [%s] (v N : voir la palette N en entier) : ' "$idx_cur"; else printf 'Choix [%s] : ' "$idx_cur"; fi
    if ((DEFAULTS)); then
      reply=""
      printf '\n'
    else read -r reply || reply=""; fi
    if [[ -n "${PREVIEW:-}" && "$reply" =~ ^[vV][[:space:]]*([0-9]+)$ && "${BASH_REMATCH[1]}" -ge 1 && "${BASH_REMATCH[1]}" -le ${#vals[@]} ]]; then
      printf '\n  — %s —\n' "${labels[BASH_REMATCH[1] - 1]}"
      "$PREVIEW" "${vals[BASH_REMATCH[1] - 1]}" full | sed 's/^/  /'
      printf '\n'
      continue
    fi
    break
  done
  [[ "$reply" =~ ^[0-9]+$ && "$reply" -ge 1 && "$reply" -le ${#vals[@]} ]] || reply="$idx_cur"
  val="${vals[reply - 1]}"
  if [[ "$val" == "$def" ]]; then unset 'CHOSEN[$var]'; else CHOSEN[$var]="$val"; fi
}

# FR : _yesno VAR "question" "défaut(1|0)" — 1 = oui.
_yesno() {
  local var="$1" q="$2" def="$3" cur="${CURRENT[$1]:-$3}" reply val hint
  _skip "$var" && return 0
  if [[ "$cur" == 1 ]]; then hint="O/n"; else hint="o/N"; fi
  printf '
%s [%s] : ' "$q" "$hint"
  if ((DEFAULTS)); then
    reply=""
    printf '\n'
  else read -r reply || reply=""; fi
  case "${reply,,}" in
    o | oui | y | yes) val=1 ;;
    n | non | no) val=0 ;;
    *) val="$cur" ;;
  esac
  if [[ "$val" == "$def" ]]; then unset 'CHOSEN[$var]'; else CHOSEN[$var]="$val"; fi
}

# FR : _text VAR "question" "défaut" [regex de validation]
_text() {
  local var="$1" q="$2" def="$3" re="${4:-.*}" cur="${CURRENT[$1]:-$3}" reply
  _skip "$var" && return 0
  printf '
%s [%s] : ' "$q" "${cur:-vide}"
  if ((DEFAULTS)); then
    reply=""
    printf '\n'
  else read -r reply || reply=""; fi
  [[ -z "$reply" ]] && reply="$cur"
  [[ "$reply" =~ ^${re}$ ]] || {
    _say "  valeur ignorée (attendu : ${re}), on garde « ${cur} »"
    reply="$cur"
  }
  if [[ "$reply" == "$def" ]]; then unset 'CHOSEN[$var]'; else CHOSEN[$var]="$reply"; fi
}

# FR : _multi VAR "question" "défaut (mots)" mot1 mot2 … — plusieurs numéros
#      séparés par des espaces ; « 0 » = aucun, vide = actuel.
_multi() {
  local var="$1" q="$2" def="$3" cur="${CURRENT[$1]:-$3}" reply i n val="" w
  _skip "$var" && return 0
  shift 3
  local -a words=("$@")
  printf '\n%s\n' "$q"
  for i in "${!words[@]}"; do
    n=$((i + 1))
    if [[ " $cur " == *" ${words[i]} "* ]]; then printf '  \e[1m%2d) %s\e[0m  ← actuel\n' "$n" "${words[i]}"; else printf '  %2d) %s\n' "$n" "${words[i]}"; fi
  done
  printf '  Numéros séparés par des espaces, 0 = aucun'
  [[ -n "$def" ]] && printf ' (défaut : %s)' "$def"
  printf '\n'
  printf 'Choix [%s] : ' "${cur:-aucun}"
  if ((DEFAULTS)); then
    reply=""
    printf '\n'
  else read -r reply || reply=""; fi
  if [[ -z "$reply" ]]; then
    val="$cur"
  elif [[ "$reply" == 0 ]]; then
    val=""
  else
    for w in $reply; do
      [[ "$w" =~ ^[0-9]+$ && "$w" -ge 1 && "$w" -le ${#words[@]} ]] && val+="${val:+ }${words[w - 1]}"
    done
  fi
  if [[ "$val" == "$def" ]]; then unset 'CHOSEN[$var]'; else CHOSEN[$var]="$val"; fi
}

printf '\e[1mCoolBash %s — configuration interactive\e[0m\n' "$VERSION"

# --- reprise d'une configuration existante ---------------------------------------
if [[ -n "$CONFIG_VERSION" ]]; then
  if ((DEFAULTS)); then
    REUSE=1
  else
    printf '\nUne configuration existe (CoolBash %s, %d réglage(s)).\n' "$CONFIG_VERSION" "${#CURRENT[@]}"
    printf '  \e[1m1) La reprendre\e[0m — seules les questions apparues depuis la %s sont posées\n' "$CONFIG_VERSION"
    printf '  2) Tout revoir\n'
    printf 'Choix [1] : '
    read -r reply || reply=""
    [[ "$reply" == 2 ]] || REUSE=1
  fi
  if ((REUSE)); then
    for var in "${!CURRENT[@]}"; do CHOSEN[$var]="${CURRENT[$var]}"; done
    if ! _newer "$VERSION" "$CONFIG_VERSION"; then
      _say "Configuration de la ${CONFIG_VERSION} reprise telle quelle : rien de nouveau à régler."
    else
      _say "Configuration de la ${CONFIG_VERSION} reprise ; questions nouvelles jusqu'à la ${VERSION} :"
    fi
  fi
else
  _say "Entrée garde la valeur actuelle (← actuel). Le résultat va dans ${CONFIG}."
fi

_title "Prompt"
PREVIEW=_theme_preview _choice COOLBASH_PROMPT_THEME "Palette du prompt (truecolor) — chaque ligne est le vrai prompt dans la palette :" coolbash \
  "coolbash|coolbash — verte et violette, la palette d'origine" "nord|nord" "dracula|dracula" \
  "solarized|solarized" "gruvbox|gruvbox" "mono|mono — gras et vidéo inverse, aucune couleur"
_choice COOLBASH_PROMPT_ICONS "Icônes du prompt :" nerd \
  "nerd|Nerd Font (police installée par coolbash install)" "basic|Unicode standard (⎇ ⚗ ⏱), sans police spéciale" "0|aucune"
_choice COOLBASH_PROMPT_EMOJI "Emoji de session en tête du prompt :" "" \
  "|un emoji au hasard à chaque shell" "none|aucun" "🐧|toujours le pingouin" "🚀|toujours la fusée"
[[ "${CHOSEN[COOLBASH_PROMPT_EMOJI]:-}" == none ]] && CHOSEN[COOLBASH_PROMPT_EMOJI]=""
_yesno COOLBASH_PROMPT_GIT "Segment git (branche, état, avance/retard, stash) ?" 1
_yesno COOLBASH_PROMPT_TOOLS "Versions php / node / rust dans les projets ?" 1
_yesno COOLBASH_PROMPT_CLOUD "Contexte Kubernetes et profil AWS ?" 1
_yesno COOLBASH_PROMPT_PATH_FISH "Chemin abrégé façon fish (~/D/coolbash) quand il est long ?" 1
_yesno COOLBASH_PROMPT_TRANSIENT "Prompt transient (réduit à une ligne après l'Entrée, expérimental) ?" 0
_text COOLBASH_PROMPT_MIN_MS "Durée d'une commande affichée à partir de (ms) :" 1000 '[0-9]+'
_text COOLBASH_PROMPT_BELL_MS "Sonnerie + notification + titre après une commande de plus de (ms, 0 = jamais) :" 30000 '[0-9]+'
_yesno COOLBASH_PS0_STAMP "Heure de départ en gris sous chaque commande ?" 1
_yesno COOLBASH_PROMPT_OSC133 "Marques de prompt OSC 133 (saut de prompt en prompt, sélection de la sortie : kitty, foot, wezterm, ghostty) ?" 1

_title "Message d'accueil (MOTD)"
_yesno COOLBASH_MOTD "Afficher le MOTD à l'ouverture d'un terminal ?" 1
_multi COOLBASH_MOTD_HIDE "Lignes du MOTD à taire :" "" date disk mem load battery reboot failed update note todo
_multi COOLBASH_FORTUNE "Thèmes de citations (aucun = tous, à poids égal) :" "" dev unix sysadmin lois corporate absurde humour-noir moralistes proverbes sciences cinema chuck
_choice COOLBASH_STARTUP_TIME "Temps de démarrage affiché sous le MOTD :" 1 \
  "1|oui — « ⚡ démarrage 80 ms · CoolBash 40 ms »" "verbose|oui, avec le temps de chaque module" "0|non"

_title "Comportement"
_yesno COOLBASH_UPDATE_CHECK "Vérifier une fois par jour, en arrière-plan, s'il y a une mise à jour ?" 1
_yesno COOLBASH_NVM_LAZY "nvm paresseux (node dans le PATH tout de suite, nvm.sh au premier appel) ?" 1
_yesno COOLBASH_HOOKS "Hooks de projet (.coolbash.bash après coolbash allow) ?" 1
_yesno COOLBASH_GIT_GUARD "Demander confirmation avant git push --force sur main ?" 1
_yesno COOLBASH_J "Noter les cd pour « j » (saut de dossier par fréquence) ?" 1
_yesno COOLBASH_CNF "Suggérer le paquet quand une commande est introuvable ?" 1
_yesno COOLBASH_FZF "Raccourcis fzf (Ctrl-R, Ctrl-T, Alt-C) s'il est installé ?" 1
_yesno COOLBASH_HIST_SECRETS "Tenir les secrets hors de l'historique (password=, token=, api_key=, Bearer…) ?" 1
_text COOLBASH_SERVE_PORT "Premier port essayé par serve :" 8000 '[0-9]{2,5}'
_yesno COOLBASH_TMUX_SSH "En SSH, attacher (ou créer) une session tmux à la connexion (détacher = Ctrl-b d) ?" 0
_choice COOLBASH_MODE "Mode du shell :" normal \
  "normal|normal — tout CoolBash" "safe|safe — shell minimal (le défaut de root) : ni MOTD, ni git dans le prompt, ni completion différée"

_title "Ton ~/.bashrc"
_choice COOLBASH_INSTALL_MODE "Comment CoolBash est chargé :" source \
  "source|une ligne « source ~/.coolbash/cli/coolbash init » — les modules sont lus à chaque shell, une mise à jour est active tout de suite" \
  "compiled|un ~/.bashrc autonome compilé — réglages et modules inlinés, aucune lecture de ~/.coolbash au chargement, régénéré par coolbash update ; se copie tel quel sur un serveur"

# --- récapitulatif et écriture -----------------------------------------------------
_title "Récapitulatif"
# FR : même tout au défaut, le fichier est écrit (en-tête seul) : il porte la
#      version, et la prochaine mise à jour ne reposera que les questions nouvelles.
if ((${#CHOSEN[@]} == 0)); then
  _say "Tout est au réglage par défaut : rien à écrire, seule la version est notée."
else
  for var in "${!CHOSEN[@]}"; do printf '  %-28s = %s\n' "$var" "${CHOSEN[$var]:-(vide)}"; done | sort
fi
mkdir -p "${COOLBASH_PREFIX}" || exit 1
{
  printf '# CoolBash %s — réglages choisis par `coolbash setup` le %s.\n' "$VERSION" "$(printf '%(%Y-%m-%d %H:%M)T' -1)"
  printf '# Sourcé avant les modules. Une variable posée dans le ~/.bashrc avant la ligne\n'
  printf '# source garde la priorité (${X:-…}). `coolbash setup` pour changer, `coolbash config`\n'
  printf '# pour tout voir.\n'
  for var in "${!CHOSEN[@]}"; do printf 'export %s="${%s:-%s}"\n' "$var" "$var" "${CHOSEN[$var]}"; done | sort
} >|"${CONFIG}.new" && mv -f "${CONFIG}.new" "$CONFIG" || exit 1
printf '\n\e[32m[CoolBash]\e[0m écrit : %s\n' "$CONFIG"

# --- ~/.bashrc : compilé ou une ligne source --------------------------------------------
BASHRC="${COOLBASH_BASHRC:-${HOME}/.bashrc}"
if [[ "${CHOSEN[COOLBASH_INSTALL_MODE]:-source}" == compiled ]]; then
  COOLBASH_BASHRC="$BASHRC" bash "$CLI" compile --write || exit 1
elif [[ -f "$BASHRC" ]] && grep -q '^# COOLBASH-COMPILED ' "$BASHRC"; then
  # FR : retour au mode source depuis un ~/.bashrc compilé : la ligne source suffit.
  cp -a "$BASHRC" "${BASHRC}.compile-$(printf '%(%Y-%m-%d-%H%M%S)T' -1)"
  printf 'source "%s/cli/coolbash" init\n' "${COOLBASH_PREFIX}" >|"$BASHRC"
  printf '\e[32m[CoolBash]\e[0m %s repasse en mode source (l\x27ancien est gardé à côté)\n' "$BASHRC"
fi
_say "\nRecharge : source ~/.bashrc (ou ouvre un terminal)."

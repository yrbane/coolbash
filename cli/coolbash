#  Description : Interface CLI pour gérer l'installation et les modules CoolBash
#
#  ⚠️  Ce fichier est SOURCÉ par ~/.bashrc (`source .../cli/coolbash init`).
#      Tout ce qu'il définit reste dans le shell de l'utilisateur. Règles :
#        - variables préfixées COOLBASH_, fonctions préfixées coolbash / _coolbash_
#        - jamais de `set -e` ni d'`exit` hors du routeur exécuté
#      Un `PREFIX=` générique a déjà cassé nvm — voir tests/test_cli_isolation.sh
# =============================================================================

COOLBASH_VERSION="0.27.0"
COOLBASH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COOLBASH_PREFIX="${COOLBASH_PREFIX:-${HOME}/.coolbash}"
COOLBASH_MODULE_DIR="${COOLBASH_MODULE_DIR:-${COOLBASH_PREFIX}/modules}"

# -----------------------------------------------------------------------------
#  Helpers d'affichage
_coolbash_log() { printf '\e[32m[CoolBash]\e[0m %s\n' "$*"; }
_coolbash_error() { printf '\e[31m[Error]\e[0m %s\n' "$*" >&2; }

# -----------------------------------------------------------------------------
#  FR : les commandes de gestion délèguent au Makefile du clone git.
#       Le clone est retrouvé via COOLBASH_REPO, le fichier .repo écrit par
#       `make install`, ou à défaut le répertoire parent de ce script.
_coolbash_make() {
  local repo
  repo="${COOLBASH_REPO:-$(cat "${COOLBASH_PREFIX}/.repo" 2>/dev/null)}"
  repo="${repo:-${COOLBASH_ROOT}}"
  if [[ ! -f "${repo}/Makefile" ]]; then
    _coolbash_error "Aucun Makefile dans ${repo} : lance cette commande depuis un clone git de CoolBash (ou définis COOLBASH_REPO)."
    return 1
  fi
  make -C "${repo}" "$@"
}

# -----------------------------------------------------------------------------
#  Commandes
_coolbash_cmd_install() { _coolbash_make install; }
_coolbash_cmd_update() { _coolbash_make update; }
_coolbash_cmd_verify() { _coolbash_make verify; }
_coolbash_cmd_test() { _coolbash_make test; }
_coolbash_cmd_uninstall() { _coolbash_make uninstall; }
_coolbash_cmd_font() { bash "${COOLBASH_ROOT}/cli/coolbash-font" install; }
_coolbash_cmd_setup() { COOLBASH_PREFIX="${COOLBASH_PREFIX}" bash "${COOLBASH_ROOT}/cli/coolbash-setup" "$@"; }
_coolbash_cmd_version() { printf '%s\n' "${COOLBASH_VERSION}"; }

# FR : réglages effectifs. Exécutée DANS le shell courant par la fonction
#      `coolbash` (voir init) : la plupart des COOLBASH_* ne sont pas exportées,
#      un sous-processus ne les verrait pas. Format : nom|défaut|rôle.
_coolbash_cmd_config() {
  local name def desc val state
  printf 'CoolBash %s — réglages (à définir avant la ligne source du ~/.bashrc)\n\n' "${COOLBASH_VERSION}"
  while IFS='|' read -r name def desc; do
    [[ -n "$name" ]] || continue
    if [[ -n "${!name+x}" ]]; then
      val="${!name}"
      state="défini"
    else
      val="$def"
      state="défaut"
    fi
    printf '  %-34s %-12s %-7s %s\n' "$name" "${val:-(vide)}" "$state" "$desc"
  done <<'COOLBASH_CONFIG'
COOLBASH_MODE|normal|normal ou safe (défaut pour root) : shell minimal
COOLBASH_DISABLE||modules à ne pas charger, ex. "70-motd 33"
COOLBASH_PROMPT_ICONS|nerd|nerd, basic (Unicode standard) ou 0
COOLBASH_PROMPT_EMOJI|(aléatoire)|emoji de session, vide = aucun
COOLBASH_PROMPT_MIN_MS|1000|durée minimale affichée dans le prompt
COOLBASH_PROMPT_BELL_MS|30000|sonnerie + notification après N ms, 0 = jamais
COOLBASH_PROMPT_GIT|1|0 = pas de segment git
COOLBASH_PROMPT_GIT_UNTRACKED|1|0 = ignorer les fichiers non suivis
COOLBASH_PROMPT_TOOLS|1|0 = pas de versions php/node
COOLBASH_PROMPT_CONTAINER_MARKERS|/.dockerenv /run/.containerenv|fichiers révélant un conteneur
COOLBASH_PS0_STAMP|1|0 = pas d'heure de départ sous la commande
COOLBASH_PS0_TITLE|1|0 = ne pas toucher au titre du terminal
COOLBASH_PS0_EXTRA||fragment ajouté à la fin de PS0
COOLBASH_PS1_OSC7|1|0 = ne pas annoncer le dossier courant (OSC 7)
COOLBASH_PROMPT_THEME|coolbash|palette du prompt : coolbash nord dracula solarized gruvbox mono (coolbash theme)
COOLBASH_PROMPT_CLOUD|1|0 = ni contexte Kubernetes ni profil AWS dans le prompt
COOLBASH_PROMPT_PROD|prod|motif qui passe le contexte cloud en rouge
COOLBASH_PROMPT_PATH_FISH|1|0 = jamais de chemin abrégé façon fish (~/D/coolbash)
COOLBASH_PROMPT_TRANSIENT|0|1 = prompt réduit à une ligne après l'Entrée (expérimental)
COOLBASH_NVM_LAZY|1|0 = charger nvm.sh au démarrage (lent)
COOLBASH_STARTUP_TIME|1|temps de démarrage affiché : 0 = non, verbose = par module
COOLBASH_FZF|1|0 = pas de raccourcis fzf (Ctrl-R)
COOLBASH_FZF_KEYBINDINGS||fichier key-bindings.bash à utiliser
COOLBASH_MOTD|1|0 = pas de MOTD (MOTD_DISABLE=1 aussi)
COOLBASH_FORTUNE|(tous)|thèmes de citations du MOTD, ex. "dev chuck"
COOLBASH_MOTD_HIDE||lignes du MOTD à taire : date disk mem load battery reboot failed update note todo
COOLBASH_UPDATE_CHECK|1|0 = ne jamais vérifier les mises à jour (git fetch quotidien en arrière-plan)
COOLBASH_UPDATE_CHECK_S|86400|intervalle entre deux vérifications, en secondes
COOLBASH_SERVE_PORT|8000|premier port essayé par serve
COOLBASH_HOOKS|1|0 = ignorer les hooks .coolbash.bash des projets
COOLBASH_GIT_GUARD|1|0 = git push --force sur main/master sans confirmation
COOLBASH_J|1|0 = ne pas noter les cd (j <motif> : saut de dossier par fréquence)
COOLBASH_CNF|1|0 = pas de suggestion de paquet pour une commande introuvable
COOLBASH_FONT|1|0 = install n'installe pas de police
COOLBASH_FONT_URL||archive .tar.xz de la police (miroir)
COOLBASH_INSTALL_MODE|source|source (une ligne dans ~/.bashrc) ou compiled (~/.bashrc autonome, coolbash compile)
COOLBASH_PREFIX|~/.coolbash|dossier d'installation
COOLBASH_REPO||clone git utilisé par install/update/test
COOLBASH_CONFIG
}

# FR : diagnostic — requis (✘ = échec) et optionnels (– = absent, informatif).
_coolbash_cmd_doctor() {
  local ko=0 n bashrc="${COOLBASH_BASHRC:-${HOME}/.bashrc}" loc
  _coolbash_req() { if "$@" >/dev/null 2>&1; then printf '  \e[32m✔\e[0m %s\n' "${COOLBASH_DOCTOR_LABEL}"; else
    printf '  \e[31m✘\e[0m %s\n' "${COOLBASH_DOCTOR_LABEL}"
    ko=$((ko + 1))
  fi; }
  _coolbash_opt() { if command -v "$1" >/dev/null 2>&1; then printf '  \e[32m✔\e[0m %-10s %s\n' "$1" "$2"; else printf '  \e[33m–\e[0m %-10s %s (absent)\n' "$1" "$2"; fi; }
  printf 'CoolBash %s — doctor\n\nRequis :\n' "${COOLBASH_VERSION}"
  COOLBASH_DOCTOR_LABEL="bash ≥ 4.4 (${BASH_VERSION})"
  _coolbash_req test "${BASH_VERSINFO[0]}${BASH_VERSINFO[1]}" -ge 44
  if grep -q '^# COOLBASH-COMPILED ' "${bashrc}" 2>/dev/null; then
    n="$(sed -n 's/^# COOLBASH-COMPILED //p' "${bashrc}" | head -1)"
    COOLBASH_DOCTOR_LABEL="${bashrc} autonome (compilé, CoolBash ${n})"
    _coolbash_req test "$n" = "${COOLBASH_VERSION}"
    [[ "$n" == "${COOLBASH_VERSION}" ]] || printf '               → recompile : coolbash compile --write (make install le fait en mode compiled)\n'
  else
    COOLBASH_DOCTOR_LABEL="${bashrc} charge cli/coolbash"
    _coolbash_req grep -qF 'cli/coolbash' "${bashrc}"
  fi
  COOLBASH_DOCTOR_LABEL="CLI installée : ${COOLBASH_PREFIX}/cli/coolbash"
  _coolbash_req test -x "${COOLBASH_PREFIX}/cli/coolbash"
  n=0
  for f in "${COOLBASH_MODULE_DIR}"/*.bash; do [[ -r "$f" ]] && n=$((n + 1)); done
  COOLBASH_DOCTOR_LABEL="modules chargés : ${n} dans ${COOLBASH_MODULE_DIR}"
  _coolbash_req test "$n" -gt 0
  n=0
  for f in "${COOLBASH_ROOT}"/share/fortunes/*.txt "${COOLBASH_PREFIX}"/fortunes/*.txt; do [[ -s "$f" ]] && n=$((n + 1)); done
  COOLBASH_DOCTOR_LABEL="citations : ${n} thème(s) dans ${COOLBASH_ROOT}/share/fortunes (+ ${COOLBASH_PREFIX}/fortunes)"
  _coolbash_req test "$n" -gt 0
  loc="${LC_ALL:-${LANG:-}}"
  COOLBASH_DOCTOR_LABEL="locale ${loc:-non définie} présente sur la machine"
  # shellcheck disable=SC2016
  _coolbash_req bash -c 'locale -a 2>/dev/null | tr "[:upper:]" "[:lower:]" | tr -d "-" | grep -qx "$(echo "$1" | tr "[:upper:]" "[:lower:]" | tr -d "-")"' _ "${loc:-C}"
  printf '\nOptionnels :\n'
  _coolbash_opt git "segment git du prompt"
  _coolbash_opt cowsay "MOTD"
  _coolbash_opt lolcat "MOTD (couleurs)"
  _coolbash_opt fzf "completion floue"
  _coolbash_opt dircolors "couleurs ls"
  _coolbash_opt shellcheck "make lint"
  _coolbash_opt shfmt "make lint / make fmt (style)"
  if command -v delta >/dev/null 2>&1 && ! git config --global --get core.pager >/dev/null 2>&1; then
    printf '               → delta est installé : git config --global core.pager delta\n'
  fi
  # FR : icônes du prompt — 0 = Nerd Font présente, 1 = absente, 2 = fc-list absent.
  bash "${COOLBASH_ROOT}/cli/coolbash-font" status
  n=$?
  case "$n" in
    0) printf '  \e[32m✔\e[0m %-10s %s\n' "police" "Nerd Font installée (icônes du prompt) — à sélectionner dans le profil du terminal" ;;
    1)
      printf '  \e[33m–\e[0m %-10s %s\n' "police" "Nerd Font absente : les icônes du prompt seront illisibles"
      printf '               → lance « coolbash font », puis choisis la police dans ton terminal\n'
      printf '               → ou sans police : export COOLBASH_PROMPT_ICONS=basic avant la ligne source du .bashrc\n'
      ;;
    *) printf '  \e[33m–\e[0m %-10s %s\n' "police" "indéterminé (fc-list absent) — sans Nerd Font : COOLBASH_PROMPT_ICONS=basic" ;;
  esac
  if [[ -n "${SSH_CONNECTION:-}${SSH_TTY:-}${SSH_CLIENT:-}" ]]; then
    printf '               ⚠ session SSH : la police doit être sur la machine qui affiche le terminal, pas ici\n'
  fi
  grep -q '^# COOLBASH-COMPILED ' "$bashrc" 2>/dev/null || _coolbash_doctor_bashrc "$bashrc"
  printf '\nMode : %s%s\n' "${COOLBASH_MODE:-$([[ $EUID -eq 0 ]] && echo safe || echo normal)}" "${COOLBASH_DISABLE:+ · désactivés : ${COOLBASH_DISABLE}}"
  unset -f _coolbash_req _coolbash_opt
  unset COOLBASH_DOCTOR_LABEL
  ((ko == 0))
}

# FR : `coolbash fortune [thème…]` — une citation, hors MOTD (test des thèmes).
_coolbash_cmd_fortune() {
  local text motd="${COOLBASH_MODULE_DIR}/70-motd.bash"
  # FR : --add "texte" [thème] → ~/.coolbash/fortunes/<thème>.txt (perso par défaut).
  if [[ "${1:-}" == --add ]]; then
    local theme="${3:-perso}" file n
    text="${2:-}"
    [[ -n "$text" ]] || {
      _coolbash_error 'usage : coolbash fortune --add "texte" [thème]'
      return 1
    }
    [[ "$theme" =~ ^[a-z0-9_-]+$ ]] || {
      _coolbash_error "thème invalide : $theme (minuscules, chiffres, - et _)"
      return 1
    }
    file="${COOLBASH_PREFIX}/fortunes/${theme}.txt"
    mkdir -p "${COOLBASH_PREFIX}/fortunes" && printf '%s\n' "$text" >>"$file" || return 1
    n=$(grep -c . "$file")
    _coolbash_log "ajoutée à ${file} — ${n} citation(s) dans le thème « ${theme} »"
    return 0
  fi
  [[ -r "$motd" ]] || motd="${COOLBASH_ROOT}/modules/70-motd.bash"
  # shellcheck disable=SC2034  # FR : lus par le module sourcé
  MOTD_DISABLE=1
  # shellcheck disable=SC1090
  source "$motd" || return 1
  # shellcheck disable=SC2034
  [[ $# -gt 0 ]] && COOLBASH_FORTUNE="$*"
  if _coolbash_fortune text; then printf '%s\n' "$text"; else
    _coolbash_error "aucune citation (thèmes : ${*:-tous})"
    return 1
  fi
}

# FR : coolbash bench [N] — N ouvertures de shell interactif (20 par défaut), avec un
#      vrai tty si `script` existe ; moyenne, min, max, puis le détail par module
#      (un démarrage en COOLBASH_STARTUP_TIME=verbose, trié).
_coolbash_cmd_bench() {
  local n="${1:-20}" i t0 t1 ms total=0 min=999999 max=0
  [[ "$n" =~ ^[0-9]+$ && "$n" -gt 0 ]] || {
    _coolbash_error "usage : coolbash bench [N]"
    return 1
  }
  local -a run
  if command -v script >/dev/null 2>&1; then run=(script -qec "bash -ic true" /dev/null); else run=(bash -ic true); fi
  printf 'CoolBash %s — bench : %d démarrage(s) de shell interactif (%s)\n' "$COOLBASH_VERSION" "$n" "${run[0]}"
  for ((i = 1; i <= n; i++)); do
    t0="${EPOCHREALTIME//[.,]/}"
    env -u COOLBASH_MOTD_SHOWN COOLBASH_STARTUP_TIME=0 "${run[@]}" >/dev/null 2>&1
    t1="${EPOCHREALTIME//[.,]/}"
    ms=$(((10#$t1 - 10#$t0) / 1000))
    total=$((total + ms))
    ((ms < min)) && min=$ms
    ((ms > max)) && max=$ms
  done
  printf '  moyenne : %d ms   (min %d ms, max %d ms)\n\nPar module, du plus lourd au plus léger :\n' $((total / n)) "$min" "$max"
  env -u COOLBASH_MOTD_SHOWN COOLBASH_STARTUP_TIME=verbose "${run[@]}" 2>/dev/null \
    | sed 's/\x1b\[[0-9;]*m//g' | grep -aE '^ +[0-9]{2}-[a-z-]+ +[0-9]+ ms' | sort -k2 -n -r
}

# FR : coolbash theme [nom] — sans argument : la liste avec un aperçu de chaque
#      palette ; avec : écrit ~/.coolbash/theme, lu par 50-prompt au chargement.
COOLBASH_THEMES="coolbash nord dracula solarized gruvbox mono"
# FR : aperçu d'une palette = le vrai PS1 construit dans ce thème, en truecolor,
#      sans les \[ \] ni les séquences de titre, avec des valeurs d'exemple.
#      $1 = thème, $2 = « full » pour les deux lignes telles qu'à l'écran.
_coolbash_theme_preview() {
  local ps1
  ps1="$(MOTD_DISABLE=1 COOLBASH_PROMPT_THEME="$1" COLORTERM=truecolor TERM=dumb HOME="${HOME}" \
    bash --norc --noprofile -c 'source "$1"; source "$2"; cd "$HOME" 2>/dev/null; _coolbash_prompt_build; printf %s "$PS1"' _ \
    "${COOLBASH_MODULE_DIR}/00-core.bash" "${COOLBASH_MODULE_DIR}/50-prompt.bash" 2>/dev/null)"
  ps1="${ps1//\\[/}"
  ps1="${ps1//\\]/}"
  ps1="${ps1//\\u/seb}"
  ps1="${ps1//\\h/machine}"
  ps1="${ps1//\\t/12:34:56}"
  ps1="${ps1//\\w/~\/Dev\/coolbash}"
  ps1="${ps1//\\\$/\$}"
  ps1="${ps1#$'\n'}"
  if [[ "${2:-}" == full ]]; then printf '%b\n' "$ps1"; else printf '%b\n' "${ps1//$'\n'/  }"; fi
}

_coolbash_cmd_theme() {
  local file="${COOLBASH_PREFIX}/theme" cur="" t
  read -r cur 2>/dev/null <"$file"
  cur="${COOLBASH_PROMPT_THEME:-${cur:-coolbash}}"
  if [[ "${1:-}" == --preview ]]; then
    [[ " $COOLBASH_THEMES " == *" ${2:-} "* ]] || {
      _coolbash_error "thème inconnu : ${2:-} (disponibles : $COOLBASH_THEMES)"
      return 1
    }
    _coolbash_theme_preview "$2" "${3:+full}"
    return 0
  fi
  if [[ -z "${1:-}" ]]; then
    printf 'Thèmes du prompt (actuel : %s) — coolbash theme <nom>\n\n' "$cur"
    for t in $COOLBASH_THEMES; do
      printf '  %-10s ' "$t"
      [[ "$t" == "$cur" ]] && printf '● ' || printf '  '
      _coolbash_theme_preview "$t"
    done
    return 0
  fi
  [[ " $COOLBASH_THEMES " == *" $1 "* ]] || {
    _coolbash_error "thème inconnu : $1 (disponibles : $COOLBASH_THEMES)"
    return 1
  }
  mkdir -p "${COOLBASH_PREFIX}" && printf '%s\n' "$1" >|"$file" || return 1
  _coolbash_log "thème « $1 » enregistré dans ${file} — ouvre un terminal, ou : source ~/.bashrc"
}

# FR : coolbash sync [--update] [--overrides] <hôte…> — pousse tes fichiers
#      personnels (fortunes/, motd.txt, theme, config.bash ; 90-local-overrides avec
#      --overrides, car il est souvent propre à une machine) vers ~/.coolbash
#      d'autres machines, par rsync sur SSH. --update y lance coolbash update.
_coolbash_cmd_sync() {
  local a update=0 overrides=0 rc=0 h
  local -a hosts=() src=()
  for a in "$@"; do
    case "$a" in
      --update) update=1 ;;
      --overrides) overrides=1 ;;
      -*)
        _coolbash_error "option inconnue : $a"
        return 1
        ;;
      *) hosts+=("$a") ;;
    esac
  done
  ((${#hosts[@]})) || {
    _coolbash_error "usage : coolbash sync [--update] [--overrides] <utilisateur@hôte…>"
    return 1
  }
  command -v rsync >/dev/null 2>&1 || {
    _coolbash_error "rsync est requis"
    return 1
  }
  [[ -d "${COOLBASH_PREFIX}/fortunes" ]] && src+=("${COOLBASH_PREFIX}/fortunes")
  [[ -f "${COOLBASH_PREFIX}/motd.txt" ]] && src+=("${COOLBASH_PREFIX}/motd.txt")
  [[ -f "${COOLBASH_PREFIX}/theme" ]] && src+=("${COOLBASH_PREFIX}/theme")
  [[ -f "${COOLBASH_PREFIX}/config.bash" ]] && src+=("${COOLBASH_PREFIX}/config.bash")
  for h in "${hosts[@]}"; do
    _coolbash_log "→ ${h}"
    if ((${#src[@]})); then rsync -az "${src[@]}" "${h}:.coolbash/" || rc=1; fi
    if ((overrides)) && [[ -f "${COOLBASH_MODULE_DIR}/90-local-overrides.bash" ]]; then
      rsync -az "${COOLBASH_MODULE_DIR}/90-local-overrides.bash" "${h}:.coolbash/modules/" || rc=1
    fi
    if ((update)); then ssh "$h" 'bash ~/.coolbash/cli/coolbash update' || rc=1; fi
  done
  ((${#src[@]} == 0 && overrides == 0)) && _coolbash_log "rien à synchroniser (pas de fortunes/, motd.txt ni theme dans ${COOLBASH_PREFIX})"
  return "$rc"
}

# FR : mise à jour disponible ? Une fois par jour (COOLBASH_UPDATE_CHECK_S), en
#      arrière-plan et sans bruit : git fetch du clone, version distante lue dans
#      origin/main:cli/coolbash, écrite dans .update-available si elle est plus
#      récente. Le MOTD lit ce fichier. COOLBASH_UPDATE_CHECK=0 désactive.
_coolbash_update_due() {
  local stamp=0
  [[ "${COOLBASH_UPDATE_CHECK:-1}" == 0 ]] && return 1
  read -r stamp 2>/dev/null <"${COOLBASH_PREFIX}/.update-check"
  [[ "$stamp" =~ ^[0-9]+$ ]] || stamp=0
  ((EPOCHSECONDS - stamp >= ${COOLBASH_UPDATE_CHECK_S:-86400}))
}
_coolbash_update_check() {
  local repo remote_ver newest
  repo="${COOLBASH_REPO:-$(cat "${COOLBASH_PREFIX}/.repo" 2>/dev/null)}"
  repo="${repo:-${COOLBASH_ROOT}}"
  [[ -d "${repo}/.git" ]] || return 0
  git -C "$repo" fetch -q origin 2>/dev/null || return 0
  remote_ver="$(git -C "$repo" show origin/main:cli/coolbash 2>/dev/null | sed -n 's/^COOLBASH_VERSION="\(.*\)"/\1/p')"
  newest="$(printf '%s\n%s\n' "$COOLBASH_VERSION" "$remote_ver" | sort -V | tail -1)"
  if [[ -n "$remote_ver" && "$remote_ver" != "$COOLBASH_VERSION" && "$newest" == "$remote_ver" ]]; then
    printf '%s\n' "$remote_ver" >|"${COOLBASH_PREFIX}/.update-available"
  else
    rm -f "${COOLBASH_PREFIX}/.update-available"
  fi
}

# FR : ce que le ~/.bashrc refait à la main alors qu'un module s'en charge :
#      nvm, cargo, pnpm, Android, foundry (35-toolchains), historique (10-history),
#      prompt (50-prompt) ; alias et fonctions → 90-local-overrides.
# FR : pourquoi une ligne du ~/.bashrc est redondante avec CoolBash ($1 = ligne,
#      $2 = variable de sortie ; vide = ligne à garder ou à déplacer telle quelle).
_coolbash_bashrc_why() {
  local -n _bw_out="$2"
  _bw_out=""
  case "$1" in
    *nvm.sh* | *NVM_DIR* | *bash_completion\"*nvm*) _bw_out="nvm : 35-toolchains le charge paresseusement (≈ 700 ms gagnés)" ;;
    *cargo/env* | *cargo/bin*) _bw_out="cargo : 35-toolchains ajoute ~/.cargo/bin s'il existe" ;;
    *PNPM_HOME*) _bw_out="pnpm : 35-toolchains" ;;
    *ANDROID_HOME* | *platform-tools*) _bw_out="Android SDK : 35-toolchains" ;;
    *foundry/bin*) _bw_out="foundry : 35-toolchains" ;;
    *HISTSIZE* | *HISTFILESIZE* | *HISTCONTROL* | *histappend*) _bw_out="historique : 10-history" ;;
    PS1=* | *PROMPT_COMMAND*) _bw_out="prompt : 50-prompt (COOLBASH_PS0_EXTRA pour un fragment personnel)" ;;
    alias\ * | function\ * | *"() {"*) _bw_out="alias/fonction : à ranger dans ~/.coolbash/modules/90-local-overrides.bash" ;;
    *export\ PATH=* | PATH=*) _bw_out="PATH : path_prepend/path_append dans 90-local-overrides (sans doublon)" ;;
  esac
}

# FR : ce que le ~/.bashrc refait à la main alors qu'un module s'en charge.
_coolbash_doctor_bashrc() {
  local file="$1" line ln=0 hits=0 why
  [[ -r "$file" ]] || return 0
  printf '\nTon %s :\n' "$file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    ln=$((ln + 1))
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    [[ "$line" == *cli/coolbash* ]] && continue
    _coolbash_bashrc_why "$line" why
    [[ -n "$why" ]] || continue
    hits=$((hits + 1))
    printf '  \e[33m–\e[0m ligne %-4s %s\n               → %s\n' "$ln" "${line:0:60}" "$why"
  done <"$file"
  if ((hits == 0)); then
    printf '  \e[32m✔\e[0m rien à déplacer : tout passe par CoolBash\n'
  else
    printf '               → coolbash tidy fait le tri (aperçu), coolbash tidy --apply l\x27applique\n'
  fi
  return 0
}

# FR : coolbash tidy [--apply] — range le ~/.bashrc : les lignes qu'un module
#      prend en charge sont retirées, `export PATH=…` devient path_prepend/append,
#      alias, fonctions et le reste vont dans 90-local-overrides.bash (en ordre,
#      sous un en-tête daté) ; il ne reste que les commentaires et la ligne
#      source. Sans --apply : l'aperçu seulement. --apply sauvegarde d'abord
#      dans ~/.bashrc.avant-coolbash-<date>.
_coolbash_cmd_tidy() {
  local apply=0 bashrc="${COOLBASH_BASHRC:-${HOME}/.bashrc}" ov="${COOLBASH_MODULE_DIR}/90-local-overrides.bash"
  local line why keep=() move=() drop=() conv found_source=0 dir
  [[ "${1:-}" == --apply ]] && apply=1
  [[ -r "$bashrc" ]] || {
    _coolbash_error "pas de ${bashrc}"
    return 1
  }
  grep -q '^# COOLBASH-COMPILED ' "$bashrc" && {
    _coolbash_error "${bashrc} est compilé (autonome) : rien à ranger — coolbash setup pour changer de mode"
    return 1
  }
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*(#|$) ]]; then
      keep+=("$line")
      continue
    fi
    if [[ "$line" == *cli/coolbash* ]]; then
      keep+=("$line")
      found_source=1
      continue
    fi
    _coolbash_bashrc_why "$line" why
    case "$why" in
      PATH*)
        # FR : export PATH="X:$PATH" → path_prepend "X" ; PATH="$PATH:X" → path_append "X".
        conv="${line#*PATH=}"
        conv="${conv#\"}"
        conv="${conv%\"}"
        if [[ "$conv" == *:\$PATH || "$conv" == *:\$\{PATH\} ]]; then
          dir="${conv%:*}"
          move+=("path_prepend \"${dir}\"")
        elif [[ "$conv" == \$PATH:* || "$conv" == \$\{PATH\}:* ]]; then
          dir="${conv#*:}"
          move+=("path_append \"${dir}\"")
        else
          move+=("$line")
        fi
        ;;
      alias* | "") move+=("$line") ;;
      *) drop+=("$line  # ${why%% :*}") ;;
    esac
  done <"$bashrc"
  ((found_source)) || keep+=("source \"${COOLBASH_PREFIX}/cli/coolbash\" init")
  if ((${#move[@]} == 0 && ${#drop[@]} == 0)); then
    _coolbash_log "${bashrc} est déjà rangé : rien à faire"
    return 0
  fi
  printf 'coolbash tidy — %s\n\n' "$bashrc"
  if ((${#drop[@]})); then
    printf '\e[33mRetirées\e[0m (un module s\x27en charge) :\n'
    printf '  – %s\n' "${drop[@]}"
  fi
  if ((${#move[@]})); then
    printf '\n\e[36mDéplacées\e[0m vers %s :\n' "$ov"
    printf '  + %s\n' "${move[@]}"
  fi
  printf '\n\e[32mConservé\e[0m dans %s : %d ligne(s) (commentaires et la ligne source)\n' "$bashrc" "${#keep[@]}"
  if ((! apply)); then
    printf '\nAperçu seulement — coolbash tidy --apply pour l\x27appliquer (sauvegarde automatique).\n'
    return 0
  fi
  local backup
  backup="${bashrc}.avant-coolbash-$(printf '%(%Y-%m-%d-%H%M%S)T' -1)"
  command cp -a -- "$bashrc" "$backup" || return 1
  mkdir -p "${ov%/*}" || return 1
  {
    [[ -s "$ov" ]] && cat "$ov"
    printf '\n# --- coolbash tidy %s : déplacé depuis %s ---\n' "$(printf '%(%Y-%m-%d)T' -1)" "$bashrc"
    if ((${#drop[@]})); then
      printf '# Retirées (un module s\x27en charge) :\n'
      printf '#   %s\n' "${drop[@]}"
    fi
    ((${#move[@]})) && printf '%s\n' "${move[@]}"
  } >|"${ov}.new" && mv -f "${ov}.new" "$ov" || return 1
  printf '%s\n' "${keep[@]}" >|"${bashrc}.new" && mv -f "${bashrc}.new" "$bashrc" || return 1
  _coolbash_log "rangé — sauvegarde : ${backup} ; recharge : source ~/.bashrc"
}

# FR : coolbash allow [chemin] / deny [chemin] — autoriser (ou retirer) le hook
#      .coolbash.bash du dossier courant (ou d'un parent). L'empreinte cksum est
#      enregistrée : un hook modifié redevient non autorisé.
_coolbash_hook_path() { # $1 = dossier de départ → stdout
  local d="$1"
  while [[ -n "$d" ]]; do
    [[ -f "$d/.coolbash.bash" ]] && {
      printf '%s' "$d/.coolbash.bash"
      return 0
    }
    d="${d%/*}"
  done
  return 1
}
_coolbash_cmd_allow() {
  local hook file="${COOLBASH_PREFIX}/allowed" fp
  hook="$(_coolbash_hook_path "$(cd "${1:-.}" 2>/dev/null && pwd)")" || {
    _coolbash_error "aucun .coolbash.bash ici ni dans un dossier parent"
    return 1
  }
  fp="$(cksum <"$hook" | cut -d' ' -f1-2)"
  mkdir -p "${COOLBASH_PREFIX}" || return 1
  {
    [[ -r "$file" ]] && grep -v -- "^${hook}	" "$file"
    printf '%s\t%s\n' "$hook" "$fp"
  } >|"${file}.new" && mv -f "${file}.new" "$file" || return 1
  _coolbash_log "autorisé : ${hook} (chargé au prochain prompt, défait en quittant le dossier)"
}
_coolbash_cmd_deny() {
  local hook file="${COOLBASH_PREFIX}/allowed"
  hook="$(_coolbash_hook_path "$(cd "${1:-.}" 2>/dev/null && pwd)")" || {
    _coolbash_error "aucun .coolbash.bash ici ni dans un dossier parent"
    return 1
  }
  [[ -r "$file" ]] && {
    grep -v -- "^${hook}	" "$file" >|"${file}.new"
    mv -f "${file}.new" "$file"
  }
  _coolbash_log "retiré : ${hook}"
}

# FR : coolbash compile [--write | fichier] — un ~/.bashrc autonome : réglages
#      (config.bash), modules inlinés dans l'ordre — chacun dans une fonction,
#      pour que ses `return` restent locaux —, fonction coolbash, vérification de
#      mise à jour, temps de démarrage. Le shell n'a plus rien à lire dans
#      ~/.coolbash au chargement (les données — citations, dirs, todo — y restent).
#      --write remplace ~/.bashrc (sauvegardé s'il ne l'était pas) ; sinon stdout
#      ou le fichier donné. Régénéré par `make install` en mode compiled.
# shellcheck disable=SC2016  # FR : les ${…} émis sont voulus littéraux dans le fichier compilé
_coolbash_compile_emit() {
  local f name fn
  printf '# CoolBash %s — ~/.bashrc autonome, généré le %s par `coolbash compile`.\n' "$COOLBASH_VERSION" "$(printf '%(%Y-%m-%d %H:%M)T' -1)"
  printf '# Ne pas éditer : régénéré par coolbash update / coolbash setup. Réglages : coolbash setup\n'
  printf '# (~/.coolbash/config.bash) ; ajouts : ~/.coolbash/modules/90-local-overrides.bash (inclus).\n'
  printf '# COOLBASH-COMPILED %s\n' "$COOLBASH_VERSION"
  printf '[[ $- == *i* ]] || return 0\n'
  printf 'COOLBASH_VERSION="%s"\n' "$COOLBASH_VERSION"
  printf 'COOLBASH_ROOT="${COOLBASH_ROOT:-%s}"\n' "$COOLBASH_PREFIX"
  printf 'COOLBASH_PREFIX="${COOLBASH_PREFIX:-%s}"\n' "$COOLBASH_PREFIX"
  printf 'COOLBASH_MODULE_DIR="${COOLBASH_MODULE_DIR:-${COOLBASH_PREFIX}/modules}"\n'
  printf 'COOLBASH_COMPILED=1\n'
  printf 'COOLBASH_THEMES="%s"\n' "$COOLBASH_THEMES"
  if [[ -r "${COOLBASH_PREFIX}/config.bash" ]]; then
    printf '\n# ===== config.bash =====\n'
    cat "${COOLBASH_PREFIX}/config.bash"
  fi
  printf '\n# ===== fonctions de la CLI =====\n'
  declare -f _coolbash_log _coolbash_error _coolbash_disabled _coolbash_shell_age_ms _coolbash_startup_report \
    _coolbash_update_due _coolbash_update_check _coolbash_cmd_config _coolbash_shell_function
  printf '\n_coolbash_t0="${EPOCHREALTIME:-}"\n_coolbash_verbose=0\n'
  printf '[[ "${COOLBASH_STARTUP_TIME:-1}" == verbose && -n "$_coolbash_t0" ]] && _coolbash_verbose=1\n'
  for f in "${COOLBASH_MODULE_DIR}"/*.bash; do
    [[ -r "$f" ]] || continue
    name="${f##*/}"
    name="${name%.bash}"
    fn="_coolbash_mod_${name//-/_}"
    printf '\n# ===== %s =====\n%s() {\n' "$name" "$fn"
    cat "$f"
    printf '\n}\nif ! _coolbash_disabled "%s"; then\n' "$name"
    printf '  _coolbash_tm="${EPOCHREALTIME:-}"\n'
    printf '  %s || _coolbash_error "module en échec : %s"\n' "$fn" "$name"
    printf '  ((_coolbash_verbose)) && printf %s "%s" $(((10#${EPOCHREALTIME//[.,]/} - 10#${_coolbash_tm//[.,]/}) / 1000))\n' "'   %-22s %4d ms\\n'" "$name"
    printf 'fi\nunset -f %s\n' "$fn"
  done
  printf '\n# ===== fin =====\n_coolbash_shell_function\n'
  printf 'if _coolbash_update_due; then\n  printf %s "$EPOCHSECONDS" >|"${COOLBASH_PREFIX}/.update-check" 2>/dev/null\n  (_coolbash_update_check &) >/dev/null 2>&1\nfi\n' "'%s\\n'"
  printf '[[ "${COOLBASH_STARTUP_TIME:-1}" != 0 ]] && _coolbash_startup_report "$_coolbash_t0"\n'
  printf 'unset _coolbash_t0 _coolbash_tm _coolbash_verbose\ntrue\n'
}
_coolbash_cmd_compile() {
  local out="" bashrc="${COOLBASH_BASHRC:-${HOME}/.bashrc}"
  case "${1:-}" in
    --write) out="$bashrc" ;;
    "")
      _coolbash_compile_emit
      return
      ;;
    *) out="$1" ;;
  esac
  if [[ "$out" == "$bashrc" && -s "$bashrc" ]] && ! grep -q '^# COOLBASH-COMPILED ' "$bashrc"; then
    # FR : première compilation par-dessus un vrai .bashrc : sauvegarde « avant CoolBash »
    #      si elle n'existe pas encore (make install l'a en général déjà faite).
    ls "${bashrc}".avant-coolbash-* >/dev/null 2>&1 || command cp -a -- "$bashrc" "${bashrc}.avant-coolbash-$(printf '%(%Y-%m-%d)T' -1)"
  fi
  if ! { _coolbash_compile_emit >|"${out}.new" && bash -n "${out}.new" && mv -f "${out}.new" "$out"; }; then
    rm -f "${out}.new"
    _coolbash_error "compilation échouée"
    return 1
  fi
  _coolbash_log "compilé : ${out} (CoolBash ${COOLBASH_VERSION}, $(grep -c '' "$out") lignes) — recharge : source ${out}"
}

# FR : COOLBASH_DISABLE="70-motd 33" — modules à ne pas charger (nom complet,
#      numéro seul ou nom sans numéro).
_coolbash_disabled() {
  local name="${1##*/}" word
  name="${name%.bash}"
  for word in ${COOLBASH_DISABLE:-}; do
    [[ "$name" == "$word" || "${name%%-*}" == "$word" || "${name#*-}" == "$word" ]] && return 0
  done
  return 1
}

# FR : âge du processus bash courant en ms (Linux : /proc). C'est le temps de
#      démarrage réel du shell, /etc/bash.bashrc et ~/.bashrc compris — pas
#      seulement CoolBash. Champ 22 de /proc/$$/stat (starttime, en 1/100 s)
#      = 20e mot après « (comm) » ; /proc/uptime a deux décimales.
_coolbash_shell_age_ms() {
  local _sa_out="$1" _sa_up _sa_stat
  read -r _sa_up _ 2>/dev/null </proc/uptime || return 1
  read -r _sa_stat 2>/dev/null <"/proc/$$/stat" || return 1
  _sa_stat="${_sa_stat##*) }"
  # shellcheck disable=SC2086
  set -- $_sa_stat
  [[ "${20:-}" =~ ^[0-9]+$ && "$_sa_up" =~ ^[0-9]+\.[0-9]{2}$ ]] || return 1
  printf -v "$_sa_out" '%d' $(((10#${_sa_up%.*}${_sa_up#*.} - 10#${20}) * 10))
}

# FR : « le bash est lent à lancer » — la première réponse est un chiffre.
#      Total = âge du shell (Linux), part CoolBash = EPOCHREALTIME (bash ≥ 5).
#      Un second `source ~/.bashrc` dans le même shell n'affiche que la part
#      CoolBash : l'âge du processus n'a alors plus de sens.
_coolbash_startup_report() {
  local t0="$1" init="" total="" ms color
  [[ -n "$t0" && -n "${EPOCHREALTIME:-}" ]] && init=$(((10#${EPOCHREALTIME//[.,]/} - 10#${t0//[.,]/}) / 1000))
  [[ -z "${COOLBASH_STARTUP_REPORTED:-}" ]] && _coolbash_shell_age_ms total
  COOLBASH_STARTUP_REPORTED=1
  ms="${total:-$init}"
  [[ -n "$ms" ]] || return 0
  if ((ms < 250)); then color='\e[32m'; elif ((ms < 700)); then color='\e[33m'; else color='\e[31m'; fi
  printf "⚡ démarrage ${color}%s ms\e[0m" "$ms"
  [[ -n "$total" && -n "$init" ]] && printf ' · CoolBash %s ms' "$init"
  printf '\n'
  if ((ms >= 250)); then
    if [[ -n "$total" && -n "$init" ]] && ((total - init > init)); then
      printf "   → l'essentiel vient d'ailleurs : /etc/bash.bashrc, ~/.profile ou le reste du ~/.bashrc\n"
    elif [[ "${COOLBASH_STARTUP_TIME:-1}" != verbose ]]; then
      printf '   → COOLBASH_STARTUP_TIME=verbose détaille le temps par module\n'
    fi
  fi
}

# FR : la fonction `coolbash` du shell et sa complétion — appelée par init, et
#      inlinée telle quelle par `coolbash compile` (declare -f).
_coolbash_shell_function() {
  unalias coolbash 2>/dev/null
  coolbash() {
    case "${1:-}" in
      config) _coolbash_cmd_config ;;
      theme)
        bash "${COOLBASH_ROOT}/cli/coolbash" "$@" || return 1
        # FR : applique le thème au shell courant sans attendre un nouveau terminal.
        if [[ -n "${2:-}" ]]; then
          COOLBASH_PROMPT_THEME="$2"
          # shellcheck disable=SC1090,SC1091
          source "${COOLBASH_MODULE_DIR}/50-prompt.bash"
        fi
        ;;
      *) bash "${COOLBASH_ROOT}/cli/coolbash" "$@" ;;
    esac
  }
  # FR : complétion de `coolbash` : sous-commandes, thèmes, thèmes de citations.
  _coolbash_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}" sub="${COMP_WORDS[1]:-}" words
    COMPREPLY=()
    if ((COMP_CWORD == 1)); then
      words="install update font verify test uninstall init version doctor config fortune bench theme sync allow deny tidy setup compile help"
    else
      case "$sub" in
        theme) words="--preview ${COOLBASH_THEMES:-coolbash nord dracula solarized gruvbox mono}" ;;
        fortune)
          words="--add"
          local f
          for f in "${COOLBASH_ROOT}"/share/fortunes/*.txt "${COOLBASH_PREFIX}"/fortunes/*.txt; do
            [[ -f "$f" ]] && f="${f##*/}" && words+=" ${f%.txt}"
          done
          ;;
        help) words="install update font verify test uninstall init version doctor config fortune bench theme sync allow deny tidy setup compile help" ;;
        sync) words="--update --overrides" ;;
        tidy) words="--apply" ;;
        compile) words="--write" ;;
        *) return 0 ;;
      esac
    fi
    mapfile -t COMPREPLY < <(compgen -W "$words" -- "$cur")
  }
  complete -F _coolbash_complete coolbash
}

# FR : charge ~/.coolbash/modules/*.bash dans l'ordre lexical (00-… avant 90-…),
#      le glob bash étant trié. Un module en échec n'empêche pas les suivants.
#      Temps de démarrage affiché en shell interactif (COOLBASH_STARTUP_TIME).
_coolbash_cmd_init() {
  local f name t0="${EPOCHREALTIME:-}" tm show=0 verbose=0
  # FR : les réglages de `coolbash setup`, avant les modules ; chaque ligne est
  #      `export X="${X:-…}"` : le ~/.bashrc garde la priorité.
  # shellcheck disable=SC1091
  [[ -r "${COOLBASH_PREFIX}/config.bash" ]] && source "${COOLBASH_PREFIX}/config.bash"
  [[ "${COOLBASH_STARTUP_TIME:-1}" != 0 && $- == *i* ]] && show=1
  [[ $show == 1 && "${COOLBASH_STARTUP_TIME:-1}" == verbose && -n "$t0" ]] && verbose=1
  for f in "${COOLBASH_MODULE_DIR}"/*.bash; do
    [[ -r "$f" ]] || continue
    _coolbash_disabled "$f" && continue
    tm="${EPOCHREALTIME:-}"
    # shellcheck disable=SC1090
    source "$f" || _coolbash_error "module en échec : $f"
    if ((verbose)); then
      name="${f##*/}"
      printf '   %-22s %4d ms\n' "${name%.bash}" $(((10#${EPOCHREALTIME//[.,]/} - 10#${tm//[.,]/}) / 1000))
    fi
  done
  ((show)) && _coolbash_startup_report "$t0"
  # FR : expose `coolbash <command>` dans le shell courant.
  #      `config` tourne dans ce shell pour voir les variables non exportées.
  _coolbash_shell_function
  # FR : vérification de mise à jour, détachée (double fork : pas de job affiché).
  if [[ $- == *i* ]] && _coolbash_update_due; then
    printf '%s\n' "$EPOCHSECONDS" >|"${COOLBASH_PREFIX}/.update-check" 2>/dev/null
    (_coolbash_update_check &) >/dev/null 2>&1
  fi
  return 0
}

# FR : coolbash help <commande> — l'aide détaillée d'une sous-commande.
_coolbash_cmd_help_topic() {
  case "$1" in
    install) echo "coolbash install — installe (ou réinstalle) CoolBash dans ~/.coolbash et ajoute la ligne source au ~/.bashrc (sauvegardé la première fois). Installe la Nerd Font sauf COOLBASH_FONT=0." ;;
    update) echo "coolbash update — git pull du clone, suite de tests, puis install. Annonce « x.y.z → a.b.c », « déjà à jour », ou l'échec (rien n'est installé si les tests échouent)." ;;
    font) echo "coolbash font — installe (ou réessaie) la JetBrainsMono Nerd Font utilisée par les icônes du prompt. À sélectionner ensuite dans le profil du terminal." ;;
    verify | lint) echo "coolbash verify — bash -n, shellcheck et shfmt sur tout le dépôt (make lint)." ;;
    test) echo "coolbash test — la suite de tests complète (make test)." ;;
    uninstall) echo "coolbash uninstall — supprime ~/.coolbash et la police installée, puis restaure le ~/.bashrc d'avant CoolBash s'il a été sauvegardé (sinon retire juste la ligne source)." ;;
    init) echo "coolbash init — charge les modules dans le shell courant (c'est ce que fait la ligne source du ~/.bashrc)." ;;
    version) echo "coolbash version — la version installée." ;;
    doctor) echo "coolbash doctor — diagnostic : bash, ~/.bashrc, modules, citations, locale, outils optionnels, Nerd Font, et ce que ton ~/.bashrc refait à la main." ;;
    config) echo "coolbash config — tous les réglages COOLBASH_* avec leur valeur effective (définie ou par défaut) et un mot d'explication. À définir avant la ligne source du ~/.bashrc, ou via coolbash setup." ;;
    fortune) printf '%s\n' "coolbash fortune [thème…] — une citation, au hasard ou dans les thèmes cités (dev unix sysadmin lois corporate absurde humour-noir moralistes proverbes sciences cinema chuck, et les tiens dans ~/.coolbash/fortunes/)." "coolbash fortune --add \"texte\" [thème] — ajoute une citation au thème (perso par défaut)." ;;
    bench) echo "coolbash bench [N] — N ouvertures de shell interactif (20 par défaut), moyenne, min, max, puis le coût de chaque module du plus lourd au plus léger." ;;
    theme) echo "coolbash theme [nom] — sans argument, la liste des palettes (coolbash nord dracula solarized gruvbox mono) avec un aperçu ; avec, l'enregistre dans ~/.coolbash/theme et l'applique au shell courant. theme --preview <nom> [--full] : l'aperçu seul (une ligne, ou le prompt complet)." ;;
    sync) echo "coolbash sync [--update] [--overrides] user@host… — pousse fortunes/, motd.txt et theme vers ~/.coolbash d'autres machines (rsync sur SSH). --overrides ajoute 90-local-overrides.bash, --update y lance coolbash update." ;;
    allow | deny) echo "coolbash allow | deny — autorise (ou retire) le hook .coolbash.bash du projet courant : sourcé à l'entrée du dossier, défait à la sortie ; modifié, il redevient non autorisé." ;;
    setup) echo "coolbash setup [--defaults] — configuration interactive, lancée aussi à la fin de install/update (reprend la configuration existante et ne pose que les questions nouvelles) : palette, icônes, emoji, segments du prompt, seuils, MOTD (lignes, thèmes de citations), temps de démarrage, mises à jour, nvm, hooks, garde-fou git, j, suggestions, fzf, port de serve, mode. Écrit ~/.coolbash/config.bash (seuls les choix hors défaut), sourcé par init avant les modules. --defaults accepte tout." ;;
    compile) echo "coolbash compile [--write | fichier] — génère un ~/.bashrc autonome : réglages de config.bash, modules inlinés dans l'ordre (chacun dans une fonction), fonction coolbash, vérification de mise à jour, temps de démarrage. Sans argument : sur la sortie standard ; --write remplace ~/.bashrc (sauvegardé) ; make install le régénère quand setup a choisi le mode compiled." ;;
    tidy) echo "coolbash tidy [--apply] — range le ~/.bashrc : retire ce qu'un module prend en charge, convertit export PATH en path_prepend/append, déplace alias et fonctions dans 90-local-overrides.bash. Sans --apply, aperçu seulement ; avec, sauvegarde d'abord." ;;
    help) echo "coolbash help [commande] — cette aide, ou le détail d'une commande." ;;
    *) return 1 ;;
  esac
}

_coolbash_cmd_help() {
  if [[ -n "${1:-}" ]]; then
    _coolbash_cmd_help_topic "$1" || {
      _coolbash_error "commande inconnue : $1"
      return 1
    }
    return 0
  fi
  cat <<HELP
CoolBash v${COOLBASH_VERSION} — Modern Bash configuration manager 😎

Usage: coolbash <command>

Commands:
  install     Install CoolBash into ~/.coolbash
  update      Update from GitHub (git clone required)
  font        Install the Nerd Font used by the prompt icons
  verify      Check syntax of all modules
  test        Run the test suite
  uninstall   Remove CoolBash
  init        Load all modules into current shell
  version     Print CoolBash version
  doctor      Check installation, locale and optional tools
  config      Show every COOLBASH_* setting with its current value
  fortune     Print one MOTD quote (optional themes: dev chuck …)
              fortune --add "text" [theme]  Add a quote to ~/.coolbash/fortunes/
  bench       Time N interactive shell startups, then the cost per module
  theme       List prompt themes with a preview, or pick one: theme nord
  allow       Trust the .coolbash.bash hook of this project (deny: revoke)
  tidy        Clean up ~/.bashrc: preview, then tidy --apply (backup first)
  setup       Interactive configuration: questions and choices → ~/.coolbash/config.bash
  compile     Standalone ~/.bashrc (settings + modules inlined): compile [--write | file]
  sync        Push fortunes/, motd.txt and theme to other machines (rsync over SSH)
              sync [--update] [--overrides] user@host…
  help        Display this help message (help <command> for details)

HELP
}

# -----------------------------------------------------------------------------
#  Router
case "${1:-}" in
  install) _coolbash_cmd_install ;;
  update) _coolbash_cmd_update ;;
  font) _coolbash_cmd_font ;;
  verify) _coolbash_cmd_verify ;;
  test) _coolbash_cmd_test ;;
  uninstall) _coolbash_cmd_uninstall ;;
  init) _coolbash_cmd_init ;;
  version) _coolbash_cmd_version ;;
  doctor) _coolbash_cmd_doctor ;;
  config) _coolbash_cmd_config ;;
  fortune)
    shift
    _coolbash_cmd_fortune "$@"
    ;;
  bench)
    shift
    _coolbash_cmd_bench "$@"
    ;;
  theme)
    shift
    _coolbash_cmd_theme "$@"
    ;;
  allow)
    shift
    _coolbash_cmd_allow "$@"
    ;;
  deny)
    shift
    _coolbash_cmd_deny "$@"
    ;;
  sync)
    shift
    _coolbash_cmd_sync "$@"
    ;;
  tidy)
    shift
    _coolbash_cmd_tidy "$@"
    ;;
  setup)
    shift
    _coolbash_cmd_setup "$@"
    ;;
  compile)
    shift
    _coolbash_cmd_compile "$@"
    ;;
  help | "")
    shift 2>/dev/null
    _coolbash_cmd_help "$@"
    ;;
  *)
    _coolbash_error "Unknown command: $1"
    _coolbash_cmd_help >&2
    false
    ;;
esac
